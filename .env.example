# Copy to .env (git-ignored) and fill in. Never commit real values.
#
# Two join modes, two sets of needs:
#   LiveKitTransportRoom  — direct join: the avatar joins the LiveKit room your bot's LiveKitTransport
#                           is already in.
#   PrivateLiveKitRoom    — relayed join: the avatar runs in a private LiveKit room of your own and its
#                           video and audio are relayed through your pipeline, so a non-LiveKit
#                           transport (SmallWebRTC, Daily, …) delivers it.

# Synthesia API key. Required by BOTH join modes.
SYNTHESIA_API_KEY=

# Synthesia API base URL. Optional for both join modes; override only for non-production environments.
# A host outside synthesia.io is refused unless SYNTHESIA_ALLOW_ANY_API_HOST=1 (http:// only for localhost).
SYNTHESIA_API_URL=https://developers.synthesia.io

# Avatar to render. The av_ prefix is added for you, so a bare id works. Used by BOTH join modes.
#
# There is no endpoint that lists your workspace's avatars (GET on the avatars path returns 405 —
# it exists, but only for creating custom ones). Two things that cost people an hour:
#   * A Studio avatar id is NOT an Interactive avatar id. They look alike. The wrong one fails with
#     404 unknown_reference about 4 s in, which presents as "the call ends before the avatar says
#     anything" rather than as a bad id.
#   * A known-good stock avatar, used by the official quickstarts, is Jenny:
#     8788bef1-8020-46e0-a8f4-510ea9989b25
SYNTHESIA_AVATAR_ID=

# LiveKit project websocket URL, e.g. wss://your-project.livekit.cloud.
#   PrivateLiveKitRoom:   REQUIRED — this is the project the private room is created in.
#   LiveKitTransportRoom: the project your bot's LiveKitTransport connects to (used by the examples).
LIVEKIT_URL=

# LiveKit API key / secret.
#   PrivateLiveKitRoom:   REQUIRED — used to create the private room and mint the bot and avatar tokens.
#   LiveKitTransportRoom: required unless you pass an avatar_token yourself; also used by
#                         examples/mint_tokens.py to mint the bot and human tokens.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Direct join only (LiveKitTransportRoom), used by examples/bot_direct_join.py. Mint both with:
#     uv run python examples/mint_tokens.py --room <name>
# It prints the bot token and a human token to join with. Run it with `uv run python`, not bare
# `python`, or you get ModuleNotFoundError: No module named 'livekit'.
LIVEKIT_ROOM=

# The bot's LiveKit access token. A short-TTL bearer token, not a long-lived credential -- expect
# to re-mint it. It must carry the top-level kind="agent" claim, or the avatar worker treats
# the bot as a human and the session never ends when the real human leaves (and keeps billing).
BOT_TOKEN=

# ---------------------------------------------------------------------------------------------
# The "brain" — speech to text, the LLM, and text to speech. Needed to RUN the examples; the
# plugin itself needs none of them. Pass --fake-brain to use scripted stand-ins instead, which
# need no keys; the example smoke test uses them too.
#
# Deepgram is absent, though other Pipecat examples use it: Cartesia covers speech to text as
# well as text to speech (CartesiaSTTService, model ink-whisper), so the default pipeline needs
# one vendor key rather than two.

# OpenAI. The LLM in the default pipeline, and the whole loop with --s2s (OpenAI Realtime).
OPENAI_API_KEY=

# Cartesia. Both ends of the default pipeline: speech to text and text to speech.
CARTESIA_API_KEY=

# Optional: which Cartesia voice to speak with. Defaults to a standard English voice.
CARTESIA_VOICE_ID=
