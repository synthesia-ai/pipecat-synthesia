# Copy to .env and fill in. Never commit real values.

# Synthesia. The avatar id must be an INTERACTIVE avatar, not a Studio one -- see the README.
# A known-good stock avatar is Jenny: 8788bef1-8020-46e0-a8f4-510ea9989b25
SYNTHESIA_API_KEY=
SYNTHESIA_AVATAR_ID=

# The LiveKit project the avatar is RENDERED in. Your users never connect to it; the avatar's
# video is pushed into the Pipecat pipeline and delivered over your own transport.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The brain. Cartesia covers speech to text as well as text to speech, so this is two keys total.
OPENAI_API_KEY=
CARTESIA_API_KEY=

# Optional: which Cartesia voice to speak with.
CARTESIA_VOICE_ID=
